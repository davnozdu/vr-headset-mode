# Очки, которые модуль считает своими. По одной паре VID:PID в строке,
# шестнадцатеричные, строчными буквами. Комментарии после # игнорируются.
#
# Файл правится на ходу: демон перечитывает его на каждой проверке,
# перезагрузка и переустановка модуля не нужны.
#
# Как узнать идентификаторы своих очков — подключите их и выполните:
#   for d in /sys/bus/usb/devices/*/; do
#     [ -f "$d/idVendor" ] && echo "$(cat $d/idVendor):$(cat $d/idProduct) $(cat $d/product 2>/dev/null)"
#   done

3318:0436   # XREAL One Pro
