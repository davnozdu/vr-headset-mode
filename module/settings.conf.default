# Задержки пробуждения очков.
#
# Очкам нужен успешный DisplayPort-линк, чтобы включить аудиоусилитель.
# Модуль ждёт его и только потом скрывает дисплей. Если гасить раньше,
# система видит гарнитуру, отдаёт ей звук, а из динамиков ничего не идёт.
#
# Файл читается при каждом запуске демона: после правки достаточно
# перезагрузиться или выполнить  pkill -f vrheadsetd.sh

# Сколько секунд ждать линка и появления звуковой карты.
READY_TIMEOUT=20

# Пауза после их появления. Карта регистрируется раньше, чем усилитель
# выходит на режим, поэтому небольшой запас обязателен. Если после
# перетыка звук всё ещё пропадает — увеличьте.
READY_GRACE=5
